# Environment variables for BRT Schedule API

# Port where the API server will listen
PORT=3000

# Environment (development, production, staging)
NODE_ENV=development

# Database path (SQLite)
DB_PATH=./src/database/brt.db

# Logging level (error, warn, info, debug)
LOG_LEVEL=info

# CORS origins (comma-separated list for production)
# In development, all origins are allowed automatically
# Example for production: https://brt.example.com,https://app.example.com
# Leave empty to use defaults for development
# CORS_ORIGINS=http://localhost:3000,http://localhost:8080
